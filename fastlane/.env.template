# Copy to `.env` and fill in. `.env` is .gitignored — never commit it.

# App Store Connect API key (App Store Connect → Users and Access → Integrations → +)
# Role: App Manager. Download the .p8 once — it's not retrievable later.
APP_STORE_CONNECT_API_KEY_ID=ABCD1234EF
APP_STORE_CONNECT_API_KEY_ISSUER_ID=12345678-1234-1234-1234-1234567890ab
APP_STORE_CONNECT_API_KEY_PATH=/Users/amrith/.appstoreconnect/AuthKey_ABCD1234EF.p8

# Your Apple ID (for any prompts that still need it)
APPLE_ID=you@example.com

# Optional: numeric ASC team ID. Leave blank on first run, fastlane will print it.
ASC_TEAM_ID=

# App Review contact info (used by push_metadata to materialize
# fastlane/metadata/review_information/*.txt at runtime; those files
# are gitignored so personal contact details never enter the repo).
REVIEW_FIRST_NAME=Your
REVIEW_LAST_NAME=Name
REVIEW_EMAIL=you@example.com
REVIEW_PHONE=+1 555 555 5555
