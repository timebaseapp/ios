default_platform(:ios)

APP_ID       = "cc.timebase.ios"
WIDGETS_ID   = "cc.timebase.ios.widgets"
APP_GROUP    = "group.cc.timebase.ios"
TEAM_ID      = "VRNNS4H6XH"
APP_NAME     = "Timezone World Clock: Timebase"
SCHEME       = "Timebase"
ICLOUD_CTNR  = "iCloud.cc.timebase.ios"

# Loaded from fastlane/.env if present
def load_dotenv
  env_path = File.expand_path("../.env", __FILE__)
  return unless File.exist?(env_path)
  File.foreach(env_path) do |line|
    line.strip!
    next if line.empty? || line.start_with?("#")
    k, v = line.split("=", 2)
    ENV[k] ||= v if k && v
  end
end

before_all do
  load_dotenv
end

# Authenticated App Store Connect API token, used for both ASC + Developer Portal.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
    duration: 1200,
    in_house: false
  )
end

#-------------------------------------------------------------------------------
# Lane: bootstrap_portal
#
# One-time setup of everything Apple Developer Portal-side:
# - Create App Group `group.cc.timebase.ios`
# - Associate it with both App IDs
# - Print remaining manual steps (WeatherKit registration)
#-------------------------------------------------------------------------------
lane :bootstrap_portal do
  api_key = asc_api_key
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(api_key)

  UI.message "Looking up App IDs..."
  primary_bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID }
  widgets_bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == WIDGETS_ID }
  UI.user_error!("App ID #{APP_ID} not found in portal") unless primary_bundle
  UI.user_error!("App ID #{WIDGETS_ID} not found in portal") unless widgets_bundle

  UI.message "Creating App Group #{APP_GROUP} (if missing)..."
  produce_app_group(
    app_group_identifier: APP_GROUP,
    app_group_name: "Timebase shared container",
    team_id: TEAM_ID
  )

  UI.message "Associating App Group with #{APP_ID}..."
  associate_app_group(
    app_identifier: APP_ID,
    app_group_identifiers: [APP_GROUP],
    team_id: TEAM_ID
  )
  UI.message "Associating App Group with #{WIDGETS_ID}..."
  associate_app_group(
    app_identifier: WIDGETS_ID,
    app_group_identifiers: [APP_GROUP],
    team_id: TEAM_ID
  )

  UI.success "Portal bootstrap complete."
  UI.important "Manual step: enable WeatherKit at:"
  UI.important "  https://developer.apple.com/account/resources/services/list"
  UI.important "  Pick WeatherKit App Services → register #{APP_ID}."
end

#-------------------------------------------------------------------------------
# Lane: bootstrap_asc
#
# Creates the App Store Connect app record so we can upload TestFlight builds.
# Idempotent — safe to run repeatedly.
#-------------------------------------------------------------------------------
lane :bootstrap_asc do
  asc_api_key

  produce(
    app_identifier: APP_ID,
    app_name: APP_NAME,
    language: "en-US",
    sku: "timebase-ios-v1",
    team_id: TEAM_ID,
    skip_itc: false,
    skip_devcenter: true,    # Already created by Xcode automatic signing
    enable_services: {
      app_group: "on",
      icloud: "legacy",
      push_notification: "on"
    }
  )

  UI.success "ASC record ready. App should now appear at appstoreconnect.apple.com."
end

#-------------------------------------------------------------------------------
# Lane: beta
#
# Bump build number, archive Release, upload to TestFlight.
#-------------------------------------------------------------------------------
lane :beta do
  api_key = asc_api_key

  ensure_clean_xcode_project

  # Bump build number based on TestFlight's latest, +1
  latest = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_ID,
    initial_build_number: 0
  )
  increment_build_number(build_number: latest + 1, xcodeproj: "Timebase.xcodeproj")

  build_app(
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: "build",
    clean: true
  )

  upload_to_testflight(
    api_key: api_key,
    skip_waiting_for_build_processing: true,
    skip_submission: true,
    apple_id: nil,
    app_identifier: APP_ID,
    changelog: ENV["CHANGELOG"] || "Latest build."
  )

  UI.success "Uploaded to TestFlight. You'll get an email when processing finishes (~10 min)."
end

#-------------------------------------------------------------------------------
# Lane: release
#
# Archive + submit to App Review with current marketing version.
# Run `bundle exec fastlane release version:1.0.1` to bump first.
#-------------------------------------------------------------------------------
lane :release do |options|
  api_key = asc_api_key

  if options[:version]
    increment_version_number(version_number: options[:version], xcodeproj: "Timebase.xcodeproj")
  end

  latest = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, initial_build_number: 0)
  increment_build_number(build_number: latest + 1, xcodeproj: "Timebase.xcodeproj")

  build_app(
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: "build",
    clean: true
  )

  upload_to_app_store(
    api_key: api_key,
    skip_screenshots: true,
    skip_metadata: false,
    submit_for_review: true,
    automatic_release: true,
    force: true,
    precheck_include_in_app_purchases: false,
    submission_information: {
      add_id_info_uses_idfa: false,
      export_compliance_uses_encryption: false
    }
  )
end

#-------------------------------------------------------------------------------
# Private helper: ensure xcodebuild's working tree is up to date with project.yml
#-------------------------------------------------------------------------------
private_lane :ensure_clean_xcode_project do
  Dir.chdir("..") do
    if File.exist?("project.yml")
      sh "xcodegen generate"
    end
  end
end

# Custom action wrapper so the App Group + association calls don't need a plugin.
def produce_app_group(app_group_identifier:, app_group_name:, team_id:)
  require "spaceship"
  Spaceship::Portal.login
  Spaceship::Portal.client.team_id = team_id
  existing = Spaceship::Portal.app_group.find(app_group_identifier)
  if existing
    UI.message "App Group #{app_group_identifier} already exists, skipping."
  else
    Spaceship::Portal.app_group.create!(group_id: app_group_identifier, name: app_group_name)
    UI.success "Created App Group #{app_group_identifier}"
  end
end

def associate_app_group(app_identifier:, app_group_identifiers:, team_id:)
  require "spaceship"
  Spaceship::Portal.login
  Spaceship::Portal.client.team_id = team_id
  app = Spaceship::Portal.app.find(app_identifier)
  UI.user_error!("App ID #{app_identifier} not found") unless app
  groups = app_group_identifiers.map { |id| Spaceship::Portal.app_group.find(id) }.compact
  app.associate_groups(groups)
  UI.success "Associated #{app_identifier} with #{app_group_identifiers.join(', ')}"
end
